{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @workspace/kin-family-safety run dev",
    "dev:all": "pnpm -r --parallel --filter @workspace/api-server --filter @workspace/kin-family-safety run dev",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:app": "pnpm --filter @workspace/kin-family-safety run dev",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test:e2e": "playwright test"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@rollup/rollup-win32-x64-msvc": "^4.64.0",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.3",
    "lightningcss-win32-x64-msvc": "^1.33.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
